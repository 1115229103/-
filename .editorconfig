root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php,py,vue,jsx,js,ts,tsx,css,html,xml,yml,yaml}]
indent_style = space
indent_size = 4

[*.{json,json5}]
indent_style = space
indent_size = 2

[*.{md,rst}]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[Dockerfile*]
indent_style = space
indent_size = 4

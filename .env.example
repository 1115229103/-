# AIStory — Environment Variables (root-level reference)
# Copy this file to .env and fill in the values for each service.

# ===== Laravel (.env) =====
# APP_NAME=AIStory
# APP_ENV=local
# APP_DEBUG=true
# APP_URL=http://localhost:8000
# APP_KEY=base64:...
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=aistory
# DB_USERNAME=root
# DB_PASSWORD=
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# FASTAPI_URL=http://localhost:8001
# FASTAPI_INTERNAL_TOKEN=<secure-random-token>
# SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ===== FastAPI (.env) =====
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=aistory
# DB_USERNAME=root
# DB_PASSWORD=
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# MASTER_KEK=<secure-random-32-byte-string>
# INTERNAL_API_TOKEN=<same-as-laravel-FASTAPI_INTERNAL_TOKEN>

# Auto-detect text files and normalize line endings
* text=auto

# PHP
*.php text eol=lf
*.blade.php text eol=lf

# Python
*.py text eol=lf

# Web
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.vue text eol=lf

# Config
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.env.example text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Dotfiles
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.wav binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary

# FastAPI Gateway Environment Variables
# Copy to .env and fill in with secure values

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aistory
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Security — MUST be set to secure random values in production
MASTER_KEK=change-me-to-a-secure-random-32-byte-string
INTERNAL_API_TOKEN=change-me-to-a-secure-random-token

# AI Request Timeouts (seconds)
AI_REQUEST_TIMEOUT=120
AI_POLL_TIMEOUT=600

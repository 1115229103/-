APP_NAME=AIStory
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aistory
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

MASTER_KEK=

FASTAPI_URL=http://localhost:8001
FASTAPI_INTERNAL_TOKEN=
FFMPEG_PATH=ffmpeg

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
SANCTUM_TOKEN_EXPIRATION=43200

# Mail (password reset, notifications)
# Dev: "log" writes to storage/logs. Prod: use "smtp" with credentials below.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@aistory.dev
MAIL_FROM_NAME="${APP_NAME}"
# SMTP settings (only needed when MAIL_MAILER=smtp)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

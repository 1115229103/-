APP_NAME=AIStory
APP_ENV=production
APP_DEBUG=false
APP_URL=https://aistory.example.com
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aistory
DB_USERNAME=aistory
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

FASTAPI_URL=http://127.0.0.1:8001
FASTAPI_INTERNAL_TOKEN=
FFMPEG_PATH=/usr/bin/ffmpeg

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Master KEK for envelope encryption (generate with: openssl rand -hex 32)
MASTER_KEK=

SANCTUM_STATEFUL_DOMAINS=aistory.example.com
SESSION_DOMAIN=.aistory.example.com
